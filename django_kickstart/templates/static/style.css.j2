/* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V5 */
/* Hallmark · genre: modern-minimal · macrostructure: Split Studio · theme: Cobalt · enrichment: none · nav: N13 · footer: Ft2 · design-system: design.md · designed-as-app · contrast: pass (40–41) · slop: pass (42–45) · honest: pass (46) · chrome: pass (47) · tokens: pass (48) · responsive: pass (49) · icons: pass (30) · mobile: pass (34, 49, 50–57) */

@import url("tokens.css");

:root {
    --color-paper: oklch(98.5% 0.004 250);
    --color-paper-2: oklch(95.5% 0.006 250);
    --color-paper-3: oklch(92.0% 0.008 250);
    --color-ink: oklch(20.0% 0.020 258);
    --color-ink-2: oklch(34.0% 0.018 257);
    --color-muted: oklch(46.0% 0.014 255);
    --color-rule: oklch(88.5% 0.008 252);
    --color-rule-2: oklch(80.0% 0.012 252);
    --color-accent: oklch(55.0% 0.200 256);
    --color-accent-hover: oklch(49.0% 0.200 256);
    --color-accent-ink: oklch(98.5% 0.004 250);
    --color-focus: oklch(55.0% 0.200 256);
    --color-success: oklch(52.0% 0.150 155);
    --color-success-bg: oklch(95.0% 0.030 155);
    --color-error: oklch(54.0% 0.190 28);
    --color-error-bg: oklch(95.0% 0.030 28);
    --color-graphite: oklch(20.0% 0.016 260);
    --color-graphite-2: oklch(25.0% 0.018 260);
    --color-graphite-rule: oklch(32.0% 0.016 260);
    --color-graphite-ink: oklch(94.5% 0.006 250);
    --color-graphite-muted: oklch(72.0% 0.010 250);
    --color-graphite-accent: oklch(70.0% 0.170 254);
    --color-scrim: oklch(16.0% 0.015 258 / 0.55);
    --shadow-whisper: 0 1px 2px oklch(20.0% 0.020 258 / 0.05);
    --font-display: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    --font-body: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
    --font-outlier: "JetBrains Mono", ui-monospace, monospace;
    --text-xs: 0.75rem;
    --text-sm: 0.875rem;
    --text-base: 1rem;
    --text-md: 1.25rem;
    --text-lg: 1.5625rem;
    --text-xl: 1.9531rem;
    --text-2xl: 2.4414rem;
    --text-display-s: clamp(1.85rem, 3vw + 0.75rem, 2.75rem);
    --text-display: clamp(2.25rem, 3.8vw + 1rem, 3.75rem);
    --space-3xs: 0.125rem;
    --space-2xs: 0.25rem;
    --space-xs: 0.5rem;
    --space-sm: 0.75rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2.5rem;
    --space-2xl: 4rem;
    --space-3xl: 6rem;
    --space-4xl: 9rem;
    --radius-control: 6px;
    --radius-surface: 10px;
    --rule-hairline: 1px solid var(--color-rule);
    --rule-strong: 1px solid var(--color-rule-2);
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-in: cubic-bezier(0.7, 0, 0.84, 0);
    --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
    --dur-micro: 120ms;
    --dur-short: 220ms;
    --dur-long: 420ms;
    --z-base: 1;
    --z-raised: 10;
    --z-dropdown: 100;
    --z-sticky: 200;
    --z-sticky-nav: 300;
    --z-modal: 400;
    --z-toast: 500;
    --z-tooltip: 600;
}

/* ─── Reset & Page Edge Clipping (Gate 34) ──────────────────────────────────── */

*,
*::before,
*::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html,
body {
    overflow-x: clip;
}

body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-ink-2);
    background-color: var(--color-paper);
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
}

::selection {
    background-color: var(--color-accent);
    color: var(--color-accent-ink);
}

/* ─── Typography Discipline (Gates 37, 38, 38a, 51) ─────────────────────────── */

h1,
h2,
h3,
h4,
.hero__title,
.section__title {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.03em;
    line-height: 1.08;
    overflow-wrap: anywhere;
    min-width: 0;
}

p {
    max-width: 65ch;
}

code,
pre,
kbd,
.tnum {
    font-family: var(--font-outlier);
    font-variant-numeric: tabular-nums;
}

code {
    font-size: var(--text-sm);
    background-color: var(--color-paper-2);
    color: var(--color-ink);
    padding: var(--space-3xs) var(--space-xs);
    border: var(--rule-hairline);
    border-radius: var(--radius-control);
}

a {
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-out);
}

a:hover {
    color: var(--color-accent);
}

a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
}

/* ─── Layout Shell ──────────────────────────────────────────────────────────── */

.container {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: clamp(var(--space-md), 4vw, var(--space-xl));
}

main {
    flex: 1;
}

/* ─── Navigation · N13 Inline ⌘K Search Pill (Gates 36, 42, 49) ─────────────── */

.navbar {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky-nav);
    background-color: var(--color-paper);
    border-bottom: var(--rule-hairline);
}

.navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 4rem;
}

.navbar__left {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
}

.navbar-brand {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 700;
    font-size: var(--text-md);
    color: var(--color-ink);
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
}

.navbar-nav {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-lg);
}

.nav__link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-2);
    line-height: 1;
    white-space: nowrap;
    padding-block: var(--space-xs);
    border-bottom: 2px solid transparent;
    transition: color var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out);
}

.nav__link:hover,
.nav__link[aria-current="page"] {
    color: var(--color-ink);
    border-bottom-color: var(--color-accent);
}

.navbar__right {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
}

.searchpill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 2.5rem;
    padding-inline: var(--space-sm);
    background-color: var(--color-paper-2);
    border: var(--rule-hairline);
    border-radius: var(--radius-control);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    outline: 2px solid transparent;
    outline-offset: 2px;
    transition: border-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out);
}

.searchpill:hover {
    border-color: var(--color-rule-2);
    color: var(--color-ink);
}

.searchpill:focus-visible {
    outline-color: var(--color-focus);
}

.searchpill__kbd {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    color: var(--color-muted);
    background-color: var(--color-paper);
    border: var(--rule-hairline);
    border-radius: var(--space-2xs);
    padding: var(--space-3xs) var(--space-2xs);
    line-height: 1;
}

/* ─── Interactive Buttons — Full 8-State Discipline (Gates 26, 36, 41, 49) ──── */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    min-height: 2.75rem;
    padding-inline: var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    border-radius: var(--radius-control);
    border: 1px solid transparent;
    cursor: pointer;
    outline: 2px solid transparent;
    outline-offset: 2px;
    transition: background-color var(--dur-micro) var(--ease-out),
                border-color var(--dur-micro) var(--ease-out),
                color var(--dur-micro) var(--ease-out),
                transform var(--dur-micro) var(--ease-out);
}

.btn--primary {
    background-color: var(--color-accent);
    color: var(--color-accent-ink);
    border-color: var(--color-accent);
}

.btn--primary:hover,
.btn--primary.is-hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: var(--color-accent-ink);
    transform: translateY(-1px);
}

.btn--secondary {
    background-color: var(--color-paper);
    color: var(--color-ink);
    border-color: var(--color-rule-2);
}

.btn--secondary:hover,
.btn--secondary.is-hover {
    background-color: var(--color-paper-2);
    color: var(--color-ink);
    transform: translateY(-1px);
}

.btn:focus-visible,
.btn.is-focus {
    outline-color: var(--color-focus);
}

.btn:active,
.btn.is-active {
    transform: translateY(0);
}

.btn:disabled,
.btn[aria-disabled="true"],
.btn.is-disabled {
    opacity: 0.55;
    cursor: not-allowed;
    transform: none;
}

.btn[data-state="loading"] {
    cursor: progress;
    opacity: 0.8;
}

.btn[data-state="error"] {
    background-color: var(--color-error);
    border-color: var(--color-error);
    color: var(--color-accent-ink);
}

.btn[data-state="success"] {
    background-color: var(--color-success);
    border-color: var(--color-success);
    color: var(--color-accent-ink);
}

/* ─── Hero · H2 Split Diptych (Gates 6, 44, 47) ─────────────────────────────── */

.hero {
    padding-block-start: var(--space-2xl);
    padding-block-end: var(--space-3xl);
    border-bottom: var(--rule-hairline);
}

.hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-2xl);
    align-items: start;
}

.hero__title {
    font-size: var(--text-display);
    margin-bottom: var(--space-md);
}

.hero__lede {
    font-size: var(--text-md);
    color: var(--color-ink-2);
    max-width: 54ch;
    margin-bottom: var(--space-lg);
}

.hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
}

/* Typographic Spec Panel (No fake OS/window chrome — Gate 47) */
.spec-panel {
    background-color: var(--color-graphite);
    color: var(--color-graphite-ink);
    border: 1px solid var(--color-graphite-rule);
    border-radius: var(--radius-surface);
    padding: var(--space-lg);
    box-shadow: var(--shadow-whisper);
}

.spec-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-graphite-rule);
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-graphite-muted);
}

.status-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-graphite-accent);
    line-height: 1;
}

.spec-panel__code {
    font-family: var(--font-outlier);
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-graphite-ink);
    overflow-x: auto;
}

.spec-panel__code .tok-muted {
    color: var(--color-graphite-muted);
}

.spec-panel__code .tok-signal {
    color: var(--color-graphite-accent);
}

/* ─── Items Section · F3 Tabular / Ruled Registry (Gates 3, 54) ─────────────── */

.items-section {
    padding-block-start: var(--space-2xl);
    padding-block-end: var(--space-3xl);
}

.section__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
}

.section__title {
    font-size: var(--text-xl);
}

.section__subtitle {
    font-size: var(--text-sm);
    color: var(--color-muted);
}

.items-grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: var(--rule-strong);
}

.item-card {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr) auto;
    gap: var(--space-lg);
    align-items: baseline;
    padding-block: var(--space-md);
    padding-inline: var(--space-sm);
    border-bottom: var(--rule-hairline);
    transition: background-color var(--dur-micro) var(--ease-out);
}

.item-card:hover {
    background-color: var(--color-paper-2);
}

.item-card h3 {
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-ink);
}

.item-card p {
    font-size: var(--text-base);
    color: var(--color-ink-2);
}

.item-card small {
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
    white-space: nowrap;
}

/* Empty State — 3 Beats (Copy.md § Empty states) */
.empty-state {
    padding: var(--space-xl);
    background-color: var(--color-paper-2);
    border: var(--rule-hairline);
    border-radius: var(--radius-surface);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
}

.empty-state__title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-ink);
}

.empty-state__copy {
    font-size: var(--text-sm);
    color: var(--color-muted);
}

/* ─── Cobalt Signature · Single Dark Graphite Band (Gate 41) ───────────────── */

.band--graphite {
    background-color: var(--color-graphite);
    color: var(--color-graphite-ink);
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--color-graphite-rule);
    border-bottom: 1px solid var(--color-graphite-rule);
}

.band--graphite h2,
.band--graphite h3 {
    color: var(--color-graphite-ink);
}

.band--graphite p {
    color: var(--color-graphite-muted);
}

.band__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: center;
}

.command-list {
    list-style: none;
    display: grid;
    gap: var(--space-xs);
    font-family: var(--font-outlier);
    font-size: var(--text-sm);
}

.command-list__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-graphite-2);
    border: 1px solid var(--color-graphite-rule);
    border-radius: var(--radius-control);
    color: var(--color-graphite-ink);
}

.command-list__label {
    color: var(--color-graphite-muted);
    font-size: var(--text-xs);
}

/* ─── About Page · Split Studio + F3 Spec Sheet ─────────────────────────────── */

.about-section {
    padding-block-start: var(--space-2xl);
    padding-block-end: var(--space-3xl);
}

.about__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: var(--space-2xl);
    align-items: start;
}

.about-section h1 {
    font-size: var(--text-display-s);
    margin-bottom: var(--space-md);
}

.about-section p {
    margin-bottom: var(--space-md);
    color: var(--color-ink-2);
}

.spec-sheet {
    width: 100%;
    border-collapse: collapse;
    border-top: var(--rule-strong);
    font-size: var(--text-sm);
}

.spec-sheet th,
.spec-sheet td {
    padding: var(--space-sm) var(--space-xs);
    border-bottom: var(--rule-hairline);
    text-align: left;
    vertical-align: baseline;
}

.spec-sheet th {
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    width: 38%;
}

.spec-sheet td {
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
}

/* ─── Form Controls — Input State Gate 39 ───────────────────────────────────── */

.form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-bottom: var(--space-md);
}

.form-label {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink);
}

.form-control {
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-ink);
    background-color: var(--color-paper);
    border: 1px solid var(--color-rule-2);
    border-radius: var(--radius-control);
    outline: 2px solid transparent;
    outline-offset: 1px;
    transition: border-color var(--dur-micro) var(--ease-out), background-color var(--dur-micro) var(--ease-out);
}

.form-control:hover {
    border-color: var(--color-ink-2);
}

.form-control:focus-visible {
    border-color: var(--color-accent);
    outline-color: var(--color-focus);
}

.form-control:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    background-color: var(--color-paper-2);
}

.form-control[aria-invalid="true"],
.form-control.is-error {
    border-color: var(--color-error);
    background-color: var(--color-error-bg);
}

.form-helper {
    min-height: 1lh;
    font-size: var(--text-xs);
    color: var(--color-muted);
}

.form-check-input {
    width: 1.125rem;
    height: 1.125rem;
    accent-color: var(--color-accent);
    cursor: pointer;
}

/* ─── Command Palette Modal · N13 Working ⌘K (Cobalt Signature) ────────────── */

.cmdk {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: var(--space-3xl);
    padding-inline: var(--space-md);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-short) var(--ease-out), visibility var(--dur-short) var(--ease-out);
}

.cmdk.is-open {
    opacity: 1;
    visibility: visible;
}

.cmdk__backdrop {
    position: fixed;
    inset: 0;
    background-color: var(--color-scrim);
}

.cmdk__panel {
    position: relative;
    z-index: var(--z-raised);
    width: 100%;
    max-width: 34rem;
    background-color: var(--color-paper);
    border: var(--rule-strong);
    border-radius: var(--radius-surface);
    box-shadow: var(--shadow-whisper);
    overflow: hidden;
    transform: translateY(-8px) scale(0.98);
    transition: transform var(--dur-short) var(--ease-out);
}

.cmdk.is-open .cmdk__panel {
    transform: translateY(0) scale(1);
}

.cmdk__field {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-bottom: var(--rule-hairline);
}

.cmdk__input {
    flex: 1;
    min-height: 2.25rem;
    border: 1px solid transparent;
    background-color: transparent;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-ink);
    outline: 2px solid transparent;
}

.cmdk__results {
    padding: var(--space-xs);
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
}

.cmdk__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 2.75rem;
    padding-inline: var(--space-sm);
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    background-color: transparent;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1;
    text-align: left;
    cursor: pointer;
    outline: 2px solid transparent;
}

.cmdk__item:hover,
.cmdk__item.is-active,
.cmdk__item:focus-visible {
    background-color: var(--color-paper-2);
    border-color: var(--color-rule-2);
    color: var(--color-accent);
}

.cmdk__hint {
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    color: var(--color-muted);
}

.cmdk__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-md);
    background-color: var(--color-paper-2);
    border-top: var(--rule-hairline);
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    color: var(--color-muted);
}

/* ─── Footer · Ft2 Inline Rule Single Line (Gates 36, 43, 49) ───────────────── */

.footer {
    border-top: var(--rule-hairline);
    background-color: var(--color-paper);
    padding-block: var(--space-lg);
}

.footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-muted);
}

.footer__links {
    display: flex;
    align-items: center;
    gap: var(--space-md);
}

.foot__link {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1;
    white-space: nowrap;
}

.foot__link:hover {
    color: var(--color-ink);
}

/* ─── Page Reveal Motion & Reduced Motion Fallback (Gate 27) ────────────────── */

.reveal {
    opacity: 0;
    transform: translateY(8px);
    animation: reveal var(--dur-long) var(--ease-out) forwards;
    animation-delay: calc(var(--i, 0) * 60ms);
}

@keyframes reveal {
    to {
        opacity: 1;
        transform: none;
    }
}

/* ─── Responsive Collapse · 60rem & 40rem (Gates 34, 49, 50, 52) ────────────── */

@media (max-width: 60rem) {
    .hero__grid,
    .band__grid,
    .about__grid {
        grid-template-columns: 1fr;
        gap: var(--space-xl);
    }

    .item-card {
        grid-template-columns: 1fr;
        gap: var(--space-xs);
    }
}

@media (max-width: 40rem) {
    .searchpill__text {
        display: none;
    }

    .navbar__left {
        gap: var(--space-md);
    }

    .navbar-nav {
        gap: var(--space-sm);
    }

    .footer__inner {
        flex-direction: column;
        align-items: flex-start;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 150ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 150ms !important;
    }

    .reveal {
        animation: reveal-reduced 150ms linear forwards;
    }

    @keyframes reveal-reduced {
        to {
            opacity: 1;
            transform: none;
        }
    }
}
